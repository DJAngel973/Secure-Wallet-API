{
  "info": {
    "name": "Secure Wallet TEST-002 regression",
    "description": "Ordered local regression flow. Run with the sanitized environment template and a private demoPassword; never export the populated environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Register Alice",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{aliceEmail}}\",\"password\":\"{{demoPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const password = pm.environment.get(\"demoPassword\");",
              "if (!password) throw new Error(\"Set demoPassword privately in the active Postman environment.\");",
              "const runId = Date.now().toString(36) + Math.random().toString(36).slice(2, 10);",
              "pm.environment.set(\"runId\", runId);",
              "pm.environment.set(\"aliceEmail\", \"alice-\" + runId + \"@example.test\");",
              "pm.environment.set(\"bobEmail\", \"bob-\" + runId + \"@example.test\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"API response contract\", () => { pm.expect(body.success).to.eql(true); pm.expect(body.message).to.be.a(\"string\"); pm.expect(body.timestamp).to.be.a(\"string\"); });",
              "pm.test(\"Registration returns tokens\", () => { pm.expect(body.data.accessToken).to.be.a(\"string\"); pm.expect(body.data.refreshToken).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
