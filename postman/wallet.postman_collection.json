              "pm.test(\"Tokens returned\", () => { pm.expect(body.data.accessToken).to.be.a(\"string\").and.not.empty; pm.expect(body.data.refreshToken).to.be.a(\"string\").and.not.empty; });",
              "pm.environment.set(\"aliceAccessToken\", body.data.accessToken);",
              "pm.environment.set(\"aliceRefreshToken\", body.data.refreshToken);"
            ]
          }
        }
      ]
