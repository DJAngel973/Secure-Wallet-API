              "pm.test(\"New USD wallet starts empty\", () => { pm.expect(body.data.id).to.be.a(\"string\"); pm.expect(body.data.currency).to.eql(\"USD\"); pm.expect(Number(body.data.balance)).to.eql(0); });",
